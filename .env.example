ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ALLOWED_MODELS=
DATABASE_PATH=./provider.db
PROVIDER_KEY_PEPPER=replace-with-a-long-random-value
ADMIN_TOKEN=replace-with-a-long-random-value
MAX_REQUEST_BYTES=1048576
MAX_INPUT_CHARS=50000
MAX_OUTPUT_TOKENS=1024
RATE_LIMIT_REQUESTS_PER_MINUTE=10
PROVIDER_HARD_STOP_USD=35
PROVIDER_WARNING_USD=25
PROVIDER_ESTIMATE_RESERVE_USD=5
INPUT_PRICE_PER_MILLION=0
OUTPUT_PRICE_PER_MILLION=0
EMERGENCY_STOP=false
UPSTREAM_TIMEOUT_SECONDS=60
