# Dormant Hack Club Auth/OIDC settings kept for possible future re-enablement.
# Current sign-in and account creation use local username/password plus invites;
# these values are not required and the OAuth routes/UI are not mounted.
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
PORTAL_REDIRECT_URI=https://provider.example.com/auth/callback
PORTAL_BOOTSTRAP_OPERATOR_EMAIL=

# Optional persistent path; default is ./provider.db
DATABASE_PATH=./provider.db

# Optional legacy default upstream only. New providers are added in the operator UI.
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
