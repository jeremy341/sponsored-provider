# Dormant Hack Club Auth/OIDC settings kept for possible future re-enablement.
# Current sign-in and account creation use local username/password plus invites;
# these values are not required and the OAuth routes/UI are not mounted.
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
PORTAL_REDIRECT_URI=https://provider.example.com/auth/callback
PORTAL_BOOTSTRAP_OPERATOR_EMAIL=

# Optional persistent path; default is ./provider.db
DATABASE_PATH=./provider.db

# Optional legacy default upstream only. New providers are added in the operator UI.
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Public origin of the portal when served behind a proxy or preview host.
# Used for the same-origin check on auth writes; an https value also switches
# session cookies to SameSite=None; Secure; Partitioned so embedded previews work.
PORTAL_PUBLIC_ORIGIN=

# Allow the portal to be embedded in an iframe (drops X-Frame-Options and
# frame-ancestors). Only enable for trusted preview/sandbox environments.
PORTAL_ALLOW_FRAMING=false

# Optional startup accounts. When both a username and password are set, the
# account is created (or its password reset) at boot. Leave empty in production.
PORTAL_BOOTSTRAP_OPERATOR_USERNAME=
PORTAL_BOOTSTRAP_OPERATOR_PASSWORD=
PORTAL_BOOTSTRAP_DEVELOPER_USERNAME=
PORTAL_BOOTSTRAP_DEVELOPER_PASSWORD=
