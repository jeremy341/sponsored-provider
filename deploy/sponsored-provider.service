[Unit]
Description=Sponsored Provider API
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/sponsored-provider/current
EnvironmentFile=-%h/apps/sponsored-provider/shared/.env
ExecStart=%h/apps/sponsored-provider/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8090 --workers 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
